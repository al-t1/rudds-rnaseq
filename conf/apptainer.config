// Tools: BioContainers images; R and collapse: built from containers/*.def
apptainer {
    enabled    = true
    autoMounts = true
    cacheDir   = "${projectDir}/containers/cache"
}

// Keep host R settings out of the containers
env {
    R_LIBS_USER    = '/nonexistent'
    R_PROFILE_USER = '/dev/null'
    R_ENVIRON_USER = '/dev/null'
}

process {
    withLabel: 'rsubread_index' { container = params.rsubread_container }
    withLabel: 'rsubread_align' { container = params.rsubread_container }
    withLabel: 'featurecounts'  { container = params.rsubread_container }
    withLabel: 'fastqc'         { container = 'quay.io/biocontainers/fastqc:0.12.1--hdfd78af_0' }
    withLabel: 'sambamba'       { container = 'quay.io/biocontainers/sambamba:1.0.1--h6f6fda4_2' }
    withLabel: 'rnaseqc'        { container = 'quay.io/biocontainers/rna-seqc:2.4.2--h29c0135_1' }
    withLabel: 'multiqc'        { container = 'quay.io/biocontainers/multiqc:1.31--pyhdfd78af_0' }
    withLabel: 'collapse'       { container = params.collapse_container }
    withLabel: 'r_small'        { container = params.r_container }
    withLabel: 'analysis'       { container = params.r_container }
}
