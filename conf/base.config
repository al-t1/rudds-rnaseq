// Resources and published outputs per step
process {
    cpus   = 1
    memory = 4.GB
    time   = 4.h

    // Retry OOM / killed tasks (more memory); other errors: let running tasks finish
    errorStrategy = { task.exitStatus in [104, 134, 137, 139, 140, 143] ? 'retry' : 'finish' }
    maxRetries    = 2

    // mga-home: 20 cpus, ~880 GB
    resourceLimits = [cpus: 20, memory: 256.GB]

    withLabel: 'rsubread_index' {
        cpus   = 1
        memory = { 32.GB * task.attempt }
        time   = 12.h
    }
    // 3 x 6 threads: alignment scales sublinearly; index ~16 GB
    withLabel: 'rsubread_align' {
        cpus     = 6
        memory   = { 30.GB * task.attempt }
        time     = 24.h
        maxForks = 3
    }
    // Runs alone, after all alignments
    withLabel: 'featurecounts' {
        cpus   = 16
        memory = { 32.GB * task.attempt }
        time   = 24.h
    }
    // Java heap = fastqc_memory_mb x threads
    withLabel: 'fastqc' {
        cpus   = 1
        memory = 12.GB
    }
    // Sort buffer = 80% of memory
    withLabel: 'sambamba' {
        cpus   = 4
        memory = { 24.GB * task.attempt }
    }
    withLabel: 'rnaseqc' {
        cpus   = 1
        memory = { 8.GB * task.attempt }
    }
    withLabel: 'collapse' {
        memory = 8.GB
    }
    withLabel: 'r_small' {
        memory = 8.GB
    }
    withLabel: 'multiqc' {
        memory = 8.GB
    }
    // 12 LINCS workers (gess_lincs)
    withLabel: 'analysis' {
        cpus   = 12
        memory = { 48.GB * task.attempt }
        time   = { params.run_bayesprism ? 48.h : 12.h }
    }

    // ── Published outputs ────────────────────────────────────────────────────
    withName: 'RSUBREAD_INDEX' {
        publishDir = [path: "${params.outdir}/reference/rsubread_index", mode: 'copy',
                      saveAs: { fn -> fn == 'versions.txt' ? null : fn }]
    }
    withName: 'COLLAPSE_GTF' {
        publishDir = [path: "${params.outdir}/reference", mode: 'copy',
                      saveAs: { fn -> fn == 'versions.txt' ? null : fn }]
    }
    withName: 'FASTQC' {
        publishDir = [path: "${params.outdir}/fastqc", mode: 'copy',
                      saveAs: { fn -> fn == 'versions.txt' ? null : fn }]
    }
    // BAMs: symlinks into work/
    withName: 'RSUBREAD_ALIGN' {
        publishDir = [path: "${params.outdir}/bam", mode: 'symlink',
                      saveAs: { fn -> fn == 'versions.txt' ? null : fn }]
    }
    withName: 'SAMBAMBA_SORT' {
        publishDir = [path: "${params.outdir}/bam_sorted", mode: 'symlink',
                      saveAs: { fn -> fn == 'versions.txt' ? null : fn }]
    }
    withName: 'RNASEQC' {
        publishDir = [path: "${params.outdir}/rnaseqc", mode: 'copy',
                      saveAs: { fn -> fn == 'versions.txt' ? null : fn }]
    }
    withName: 'FEATURECOUNTS' {
        publishDir = [path: "${params.outdir}/counts", mode: 'copy',
                      saveAs: { fn -> fn == 'versions.txt' ? null : fn }]
    }
    withName: 'QC_TABLE' {
        publishDir = [path: "${params.outdir}/qc_table", mode: 'copy']
    }
    withName: 'MULTIQC' {
        publishDir = [path: "${params.outdir}/multiqc", mode: 'copy']
    }
    withName: 'ANALYSIS' {
        publishDir = [path: "${params.outdir}/analysis", mode: 'copy']
    }
}
