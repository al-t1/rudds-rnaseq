process {
    executor = 'slurm'
    queue    = 'common'
    // mga-home only (not mga-n2 / mga-n3); no SLURM requeue (Nextflow retries)
    clusterOptions = '--no-requeue --nodelist=mga-home'
}

executor {
    name            = 'slurm'
    queueSize       = 8          // running + pending jobs
    submitRateLimit = '10/1min'
    pollInterval    = '30 sec'
}
