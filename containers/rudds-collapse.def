Bootstrap: docker
From: python:3.12-slim

# collapse_annotation.py (GTEx) dependencies
# Build:  apptainer build --fakeroot rudds-collapse.sif rudds-collapse.def

%labels
    Description GTEx collapse_annotation.py dependencies
    Version 0.1.0

%post
    # procps: 'ps' for Nextflow
    apt-get update && apt-get install -y --no-install-recommends procps && rm -rf /var/lib/apt/lists/*
    pip install --no-cache-dir numpy==2.1.3 pandas==2.2.3 bx-python==0.13.0

%test
    command -v ps
    python3 -c 'import numpy, pandas, bx.intervals.intersection; print("ok")'
