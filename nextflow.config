manifest {
    name            = 'rudds-dge'
    description     = 'RUDDS lumbar disc RNA-seq: FASTQ to the manuscript figures and tables'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}

// Input files: see README, "Input files"
params {
    assets     = "${projectDir}/assets"
    outdir     = 'results'

    // ── Upstream ────────────────────────────────────────────────────────────
    input            = "${params.assets}/samplesheet.csv"   // sample,fastq_1,fastq_2
    gtf              = "${params.assets}/gencode.v47.basic.annotation.gtf.gz"
    rsubread_index   = null      // existing index prefix; else built from fasta
    fasta            = null
    index_name       = 'RSR_human_genome'
    collapsed_gtf    = null      // existing RNA-SeQC gene model; else built
    collapse_script  = "${projectDir}/scripts/collapse_annotation.py"
    fastqc_memory_mb = 9000
    counts_prefix    = 'RSR_counts'
    st1_metadata     = "${params.assets}/ST1_metadata.tsv"
    skip_multiqc     = false

    // ── Analysis only: existing counts + ST1 ────────────────────────────────
    counts = null
    st1    = "${params.assets}/ST1_QC_metrics.tsv"

    // ── Analysis ────────────────────────────────────────────────────────────
    skip_analysis   = false
    analysis_script = "${projectDir}/scripts/analysis.R"
    core_functions  = "${projectDir}/scripts/core_functions.R"
    sample_metadata = "${params.assets}/ST_safe_Sheets.tsv"
    deconvolution   = "${params.assets}/ST2_deconvolution.tsv"
    ora_layout      = "${params.assets}/ORA_layout_top_5_5.json"
    collectri       = "${params.assets}/CollecTRI_human.tsv"
    mirdb           = "${params.assets}/MSigDB_C3_MIRDB.tsv"
    kegg            = "${params.assets}/KEGG_hsa_pathways.tsv"
    experimenthub   = "${params.assets}/ExperimentHub"
    jin_xlsx        = "${params.assets}/40779_2025_637_MOESM3_ESM.xlsx"
    ot_files        = "${params.assets}/*_OT-*-associated-targets-*.tsv"
    run_bayesprism  = false      // recompute ST2 (hours) from bayesprism_ref
    bayesprism_ref  = null

    // ── Containers ──────────────────────────────────────────────────────────
    r_container        = "${projectDir}/containers/rudds-r.sif"
    collapse_container = "${projectDir}/containers/rudds-collapse.sif"
    rsubread_container = 'quay.io/biocontainers/bioconductor-rsubread:2.20.0--r44h15a9599_1'
}

includeConfig 'conf/base.config'

profiles {
    standard {
        process.executor = 'local'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
    apptainer {
        includeConfig 'conf/apptainer.config'
    }
}

timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
}
report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/report.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/dag.html"
}
